#!/usr/bin/env bash
# skyline-apps: pick your everyday apps and install them in one go.
set -euo pipefail
# shellcheck source=/dev/null
. "${SKYLINE_LIB:-/usr/lib/skyline}/i18n.sh"

# Offer NVIDIA's driver only on PCs with an NVIDIA card that don't have it yet.
nvidia_choice=()
if lspci 2>/dev/null | grep -qi nvidia && ! command -v nvidia-smi >/dev/null 2>&1; then
	nvidia_choice=(nvidia "$(t "NVIDIA graphics driver (games, external monitors)")" on)
fi

choices=$(kdialog --title "$(t "SkyLine Apps")" --icon skyline --geometry 480x440 --separate-output --checklist \
	"$(t "Pick the apps you want. SkyLine installs them for you.")" \
	claude "$(t "Claude (AI assistant)")" on \
	discord "Discord" on \
	steam "$(t "Steam (games)")" on \
	sober "$(t "Roblox player (Sober, unofficial)")" off \
	vinegar "$(t "Roblox Studio (Vinegar, unofficial)")" off \
	prism "Minecraft (Prism Launcher)" off \
	spotify "Spotify" off \
	vscode "Visual Studio Code" off \
	obs "$(t "OBS Studio (record and stream)")" off \
	"${nvidia_choice[@]}") || exit 0

[[ -n $choices ]] || exit 0
mapfile -t picked <<<"$choices"

# Show progress in a terminal window so nothing happens silently.
exec konsole --hold -e /usr/lib/skyline/install-apps "${picked[@]}"
