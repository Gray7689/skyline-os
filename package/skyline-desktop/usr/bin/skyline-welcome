#!/usr/bin/env bash
# skyline-welcome: on the live USB, a short hint; on an installed SkyLine, the first-start setup (once).
set -euo pipefail
# shellcheck source=/dev/null
. "${SKYLINE_LIB:-/usr/lib/skyline}/i18n.sh"

if grep -qw 'boot=live' /proc/cmdline; then
	flag="${XDG_RUNTIME_DIR:-/tmp}/skyline-welcome-shown"
	[[ -e $flag ]] && exit 0
	touch "$flag"
	kdialog --title "$(t "Welcome to SkyLine")" --icon skyline --msgbox \
		"$(t "You're trying SkyLine from the USB stick. Nothing on your PC has changed.")

$(t "When you're ready, open \"Install SkyLine\" on the desktop or in the launcher.")"
	exit 0
fi

conf="${XDG_CONFIG_HOME:-$HOME/.config}/skyline"
# Already set up (or using SkyLine since before the setup existed): nothing to do.
[[ -e $conf/setup-done || -e $conf/welcome-done ]] && exit 0
mkdir -p "$conf"
touch "$conf/welcome-done"
exec skyline-setup
