#!/usr/bin/env bash
# skyline-layout: switch the whole desktop layout in one click.
#
#   skyline-layout classic   one bar at the bottom (like Windows)
#   skyline-layout dock      top bar + app dock at the bottom (like a Mac)
#   skyline-layout minimal   one small floating bar
#   skyline-layout shell     SkyLine Shell: top bar + dock with the Cloud Menu and Puff
#   skyline-layout menu      pick in a small window
#
# After switching you can still drag, resize and edit every panel: right-click it > "Show Panel Configuration".
set -euo pipefail

DIR=/usr/lib/skyline/layouts
CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/skyline"

usage() {
	sed -n '2,11s/^# \{0,1\}//p' "$0"
}

apply() {
	local file="$DIR/$1.js"
	if [[ ! -f $file ]]; then
		echo "Unknown layout: $1" >&2
		exit 2
	fi
	dbus-send --session --print-reply --dest=org.kde.plasmashell /PlasmaShell \
		org.kde.PlasmaShell.evaluateScript "string:$(cat "$file")" >/dev/null
	mkdir -p "$CONF_DIR"
	echo "layout=$1" >"$CONF_DIR/layout.conf"
	# New panels start with the default look; bring back a black/white/glass/clear taskbar.
	skyline-taskbar reapply >/dev/null 2>&1 || true
}

menu() {
	local choice
	# shellcheck source=/dev/null
	. "${SKYLINE_LIB:-/usr/lib/skyline}/i18n.sh"
	choice=$(kdialog --title "$(t "SkyLine Layout")" --icon skyline --radiolist \
		"$(t "Pick a desktop layout. Your current panels will be replaced.")" \
		shell "$(t "SkyLine Shell: top bar and a dock with Puff")" on \
		classic "$(t "Classic: one bar at the bottom")" off \
		dock "$(t "Dock: top bar and an app dock")" off \
		minimal "$(t "Minimal: one small floating bar")" off) || exit 0
	[[ -n $choice ]] && apply "$choice"
}

case "${1:-menu}" in
	classic | dock | minimal | shell) apply "$1" ;;
	menu) menu ;;
	-h | --help) usage ;;
	*)
		usage >&2
		exit 2
		;;
esac
