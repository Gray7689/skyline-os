#!/usr/bin/env python3
"""SkyLine Assistant: Puff, a little pixel cloud that changes your desktop when you ask.

Works offline for everyday requests ("make it night", "dock layout", "install discord").
Add a Claude or Groq API key in SkyLine Settings > Assistant to chat about anything.
"""
import math
import os
import re
import sys

sys.path.insert(0, os.environ.get("SKYLINE_LIB", "/usr/lib/skyline"))
import skyline_ai as ai  # noqa: E402
import skyline_common as sk  # noqa: E402

from PyQt6.QtCore import QObject, QRect, Qt, QThread, QTimer, pyqtSignal  # noqa: E402
from PyQt6.QtGui import QColor, QIcon, QPainter  # noqa: E402
from PyQt6.QtWidgets import (QApplication, QFrame, QHBoxLayout, QLabel, QLineEdit,  # noqa: E402
                             QPushButton, QScrollArea, QSizePolicy, QVBoxLayout, QWidget)

ASKED_FLAG = sk.CONFIG_DIR / "assistant-asked"

HELP = ("I can change your sky (sunrise, day, dusk, night or automatic), the desktop layout "
        "(classic, dock, minimal), the taskbar (black, white, glass, clear), Game Mode, real weather, "
        "the accent color, and install or open apps. Try: \"make it night\" or \"install discord\".")
NO_KEY = ("I didn't get that one. I understand requests like \"night sky\", \"dock layout\", "
          "\"clear taskbar\", \"game mode on\" or \"install steam\". To chat about anything, press "
          "\"Connect AI\" at the top and add a key (Claude, OpenAI, NVIDIA, Groq, Gemini and more).")


# ======================================================================= the offline brain

def _words(text):
    return " " + re.sub(r"[^\w#\s]", " ", text.lower()) + " "


def _has(t, *phrases):
    return any(f" {p} " in t for p in phrases)


OFF_WORDS = ("off", "stop", "disable", "disattiva", "spegni", "togli", "turn off")

APP_WORDS = [  # checked in order: "roblox studio" before "roblox"
    ("roblox studio", "vinegar"), ("vinegar", "vinegar"), ("roblox", "sober"), ("sober", "sober"),
    ("claude", "claude"), ("discord", "discord"), ("steam", "steam"), ("minecraft", "prism"),
    ("prism", "prism"), ("spotify", "spotify"), ("vs code", "vscode"), ("vscode", "vscode"),
    ("visual studio code", "vscode"), ("obs", "obs"), ("nvidia", "nvidia"), ("driver", "nvidia"),
    ("drivers", "nvidia"),
]


def local_brain(text):
    """Understand common requests without the internet. Returns a reply, or None."""
    t = _words(text)
    replies = []
    off = _has(t, *OFF_WORDS)

    if _has(t, "help", "aiuto", "what can you do", "cosa sai fare", "commands", "comandi"):
        return HELP
    if len(t.split()) <= 3 and _has(t, "hi", "hello", "hey", "ciao", "salve", "yo"):
        return "Hi! I'm Puff, your SkyLine cloud. " + HELP

    # Own wallpaper
    if _has(t, "my wallpaper", "my own wallpaper", "mio sfondo", "my background"):
        keep = not off and not _has(t, "change it", "cambialo", "use sky", "sky wallpaper")
        replies.append(sk.keep_own_wallpaper(keep))

    # Game Mode
    if _has(t, "game mode", "gamemode", "modalità gioco", "modalita gioco", "gaming mode", "modalità gaming"):
        replies.append(sk.set_gamemode(not off))

    # Taskbar style
    if _has(t, "taskbar", "barra", "panel", "pannello", "bar", "barra delle applicazioni"):
        style = None
        if _has(t, "black", "nero", "nera", "nere"):
            style = "black"
        elif _has(t, "white", "bianco", "bianca"):
            style = "white"
        elif _has(t, "glass", "vetro", "see through", "translucent", "semi"):
            style = "glass"
        elif _has(t, "transparent", "trasparente", "clear", "invisible", "invisibile"):
            style = "clear"
        elif _has(t, "normal", "default", "auto", "normale", "automatic", "automatico"):
            style = "auto"
        if style:
            replies.append(sk.set_taskbar(style))

    # Layout
    layout = None
    if _has(t, "dock", "mac", "macos"):
        layout = "dock"
    elif _has(t, "classic", "classico", "like windows", "come windows"):
        layout = "classic"
    elif _has(t, "minimal", "minimale", "minimalist", "minimalista"):
        layout = "minimal"
    if layout:
        replies.append(sk.set_layout(layout))

    # Weather
    if _has(t, "weather", "meteo"):
        place = None
        m = re.search(r"\b(?:in|for|per|a)\s+([A-Za-zÀ-ÿ' .-]{2,40})\s*$", text.strip())
        if m:
            place = m.group(1).strip()
        replies.append(sk.set_weather(not off, place))

    # Accent color
    if _has(t, "accent", "accento", "color", "colour", "colore"):
        color = None
        for words, name in [(("coral", "corallo", "orange", "arancione"), "coral"),
                            (("blue", "blu", "azzurro"), "sky"),
                            (("lavender", "purple", "viola", "lilla"), "lavender"),
                            (("mint", "green", "verde"), "mint"),
                            (("yellow", "giallo", "gold"), "sun"),
                            (("pink", "rosa"), "pink"),
                            (("none", "default", "normal", "sky colors", "normale"), "none")]:
            if _has(t, *words):
                color = name
                break
        if color:
            replies.append(sk.set_accent(color))

    # Install apps
    if _has(t, "install", "installa", "download", "scarica", "get me", "metti"):
        ids = []
        for phrase, app_id in APP_WORDS:
            if f" {phrase} " in t and app_id not in ids and not (app_id == "sober" and "vinegar" in ids):
                ids.append(app_id)
        if ids:
            replies.append(sk.install_apps(ids))

    # Open apps
    m = re.search(r"\b(?:open|apri|launch|avvia|start)\s+(?:the\s+|il\s+|la\s+|lo\s+)?(.+)$", text.strip(), re.I)
    if m and not replies:
        replies.append(sk.open_app(m.group(1).strip(" .!?")))

    # Sky (last, so "black taskbar" isn't read as a dark sky)
    if not replies or (_has(t, "sky", "cielo", "wallpaper", "sfondo", "theme", "tema")
                       and not _has(t, "my wallpaper", "mio sfondo", "my own wallpaper", "my background")):
        sky = None
        if _has(t, "follow", "automatic", "automatico", "auto", "time of day"):
            sky = "auto" if _has(t, "sky", "cielo", "wallpaper", "sfondo", "theme", "tema", "time of day") else None
        if sky is None:
            if _has(t, "night", "notte", "dark", "scuro", "scura", "dark mode", "modalità scura"):
                sky = "night"
            elif _has(t, "sunrise", "alba", "morning", "mattina", "peach"):
                sky = "sunrise"
            elif _has(t, "dusk", "sunset", "tramonto", "lavender", "evening", "sera"):
                sky = "dusk"
            elif _has(t, "day", "giorno", "noon", "light mode", "daytime"):
                sky = "day"
        if sky:
            replies.append(sk.set_sky(sky))

    return " ".join(replies) if replies else None


# ======================================================================= the AI brain (optional)

def run_tool(name, args):
    """Called by the AI model to change things."""
    try:
        if name == "set_sky":
            return sk.set_sky(args.get("mode", ""))
        if name == "set_layout":
            return sk.set_layout(args.get("name", ""))
        if name == "set_taskbar":
            return sk.set_taskbar(args.get("style", ""))
        if name == "set_game_mode":
            return sk.set_gamemode(bool(args.get("on")))
        if name == "set_weather":
            return sk.set_weather(bool(args.get("on")), args.get("place") or None)
        if name == "set_accent":
            return sk.set_accent(args.get("color", "none"))
        if name == "install_apps":
            return sk.install_apps(list(args.get("apps", [])))
        if name == "open_app":
            return sk.open_app(args.get("name", ""))
        if name == "keep_own_wallpaper":
            return sk.keep_own_wallpaper(bool(args.get("on")))
    except Exception as e:  # a failing action shouldn't crash the chat
        return f"That didn't work: {e}"
    return f"Unknown tool {name}."


class Brain(QObject):
    answered = pyqtSignal(str)

    def __init__(self):
        super().__init__()
        self.history = []

    def ask(self, text):
        cfg = ai.load()
        if ai.ready(cfg):
            self.history.append({"role": "user", "content": text})
            self.history = self.history[-20:]
            try:
                reply = ai.chat(cfg, self.history, run_tool, local_actions=lambda: local_brain(text))
            except ai.AIError as e:
                reply = local_brain(text) or (f"I couldn't reach my AI brain ({e}). I can still do simple "
                                              "things like \"night sky\" or \"install discord\".")
            except Exception as e:  # unexpected answer format
                reply = local_brain(text) or f"Something went wrong talking to the AI: {e}"
            self.history.append({"role": "assistant", "content": reply})
        else:
            reply = local_brain(text) or NO_KEY
        self.answered.emit(reply)


# ======================================================================= Puff the pixel cloud

PUFF = [
    "......oooo......",
    "...oooowwwwo....",
    "..owwwwwwwwwoo..",
    ".owwwwwwwwwwwwo.",
    "owwwwwwwwwwwwwwo",
    "owwweewwwweewwwo",
    "owwweewwwweewwwo",
    "owbbwwwwwwwwbbwo",
    "owwwwwmwwmwwwwwo",
    ".owwwwwmmwwwwwo.",
    "..oooooooooooo..",
]
PUFF_COLORS = {"o": "#23264A", "w": "#FFFFFF", "e": "#23264A", "m": "#23264A", "b": "#FFB3A6"}


class Puff(QWidget):
    def __init__(self, pixel=5):
        super().__init__()
        self.pixel = pixel
        self.phase = 0.0
        self.blink = 0
        self.busy = False
        self.setFixedSize(16 * pixel + 4, 11 * pixel + 12)
        self.timer = QTimer(self)
        self.timer.timeout.connect(self.tick)
        self.timer.start(60)

    def tick(self):
        self.phase += 0.35 if self.busy else 0.12
        self.blink = self.blink - 1 if self.blink > 0 else (3 if int(self.phase * 10) % 70 == 0 else 0)
        self.update()

    def paintEvent(self, _):
        p = QPainter(self)
        dy = round((math.sin(self.phase) + 1) * 3)
        for y, row in enumerate(PUFF):
            for x, ch in enumerate(row):
                if ch == ".":
                    continue
                if ch == "e" and self.blink and y == 5:
                    ch = "w"
                p.fillRect(QRect(2 + x * self.pixel, 2 + dy + y * self.pixel, self.pixel, self.pixel),
                           QColor(PUFF_COLORS[ch]))
        p.end()


# ======================================================================= the window

class Bubble(QLabel):
    def __init__(self, text, mine):
        super().__init__(text)
        self.setWordWrap(True)
        self.setTextInteractionFlags(Qt.TextInteractionFlag.TextSelectableByMouse)
        self.setMaximumWidth(300)
        self.setSizePolicy(QSizePolicy.Policy.Maximum, QSizePolicy.Policy.Minimum)
        if mine:
            self.setStyleSheet("QLabel { background: palette(highlight); color: palette(highlighted-text);"
                               " border-radius: 14px; padding: 8px 12px; }")
        else:
            self.setStyleSheet("QLabel { background: palette(alternate-base); color: palette(text);"
                               " border-radius: 14px; padding: 8px 12px; }")


class AssistantWindow(QWidget):
    asked = pyqtSignal(str)

    def __init__(self):
        super().__init__()
        self.setWindowTitle("SkyLine Assistant")
        self.setWindowIcon(QIcon.fromTheme("skyline", QIcon(sk.LOGO)))
        self.resize(420, 640)

        header = QFrame()
        header.setObjectName("header")
        header.setStyleSheet("#header { background: #FFD8CC; border-radius: 16px; }"
                             "#header QLabel { color: #23264A; background: transparent; }")
        self.puff = Puff()
        name = QLabel("<b style='font-size:16pt'>Puff</b>")
        self.status = QLabel("Your SkyLine cloud. Ask me to change things!")
        self.status.setWordWrap(True)
        self.ai_button = QPushButton()
        self.ai_button.setStyleSheet("QPushButton { background: #FFFFFF; color: #23264A; border: none;"
                                     " border-radius: 10px; padding: 6px 10px; }")
        self.ai_button.clicked.connect(self.connect_ai)
        text_col = QVBoxLayout()
        text_col.addWidget(name)
        text_col.addWidget(self.status)
        h = QHBoxLayout(header)
        h.setContentsMargins(14, 10, 14, 10)
        h.addWidget(self.puff)
        h.addLayout(text_col, 1)
        h.addWidget(self.ai_button, 0, Qt.AlignmentFlag.AlignTop)

        self.chat = QVBoxLayout()
        self.chat.setSpacing(8)
        self.chat.addStretch(1)
        holder = QWidget()
        holder.setLayout(self.chat)
        self.scroll = QScrollArea()
        self.scroll.setWidgetResizable(True)
        self.scroll.setFrameShape(QFrame.Shape.NoFrame)
        self.scroll.setWidget(holder)

        chips = QHBoxLayout()
        for label, request in [("Night sky", "make it night"), ("Dock layout", "dock layout"),
                               ("Clear taskbar", "clear taskbar"), ("Game Mode", "game mode on")]:
            b = QPushButton(label)
            b.setStyleSheet("QPushButton { border: 1px solid palette(mid); border-radius: 12px; padding: 5px 9px; }")
            b.clicked.connect(lambda _=False, r=request: self.send(r))
            chips.addWidget(b)

        self.input = QLineEdit()
        self.input.setPlaceholderText("Ask Puff… (for example: make it night)")
        self.input.returnPressed.connect(lambda: self.send(self.input.text()))
        send = QPushButton("Send")
        send.setDefault(True)
        send.clicked.connect(lambda: self.send(self.input.text()))
        row = QHBoxLayout()
        row.addWidget(self.input, 1)
        row.addWidget(send)

        layout = QVBoxLayout(self)
        layout.setContentsMargins(12, 12, 12, 12)
        layout.addWidget(header)
        layout.addWidget(self.scroll, 1)
        layout.addLayout(chips)
        layout.addLayout(row)

        self.brain = Brain()
        self.thread = QThread(self)
        self.brain.moveToThread(self.thread)
        self.asked.connect(self.brain.ask)
        self.brain.answered.connect(self.on_answer)
        self.thread.start()

        smart = ai.ready(ai.load())
        self.refresh_ai_button()
        self.add("Hi! I'm Puff. I can change your sky, layout and taskbar, turn on Game Mode, and install or "
                 "open apps." + (" Ask me anything!" if smart else ""), mine=False)
        if not smart and not ASKED_FLAG.exists():
            self.offer_ai()

    def refresh_ai_button(self):
        cfg = ai.load()
        if ai.ready(cfg):
            self.ai_button.setText("AI: " + ai.PROVIDERS[cfg["provider"]]["label"].split(" (")[0])
        else:
            self.ai_button.setText("Connect AI")

    def offer_ai(self):
        """First time: ask the user to connect an AI so they can really talk with Puff."""
        box = QFrame()
        box.setStyleSheet("QFrame { background: palette(alternate-base); border-radius: 14px; }"
                          "QLabel { background: transparent; }")
        text = QLabel("Want to really talk with me? Connect an AI with your own API key: Claude, OpenAI, NVIDIA, "
                      "Groq, Gemini, OpenRouter, or Ollama on this computer (no key needed).")
        text.setWordWrap(True)
        yes = QPushButton("Connect an AI")
        later = QPushButton("Not now")
        row = QHBoxLayout()
        row.addWidget(yes)
        row.addWidget(later)
        row.addStretch(1)
        v = QVBoxLayout(box)
        v.addWidget(text)
        v.addLayout(row)
        self.chat.addWidget(box)

        def answered(connect):
            sk.CONFIG_DIR.mkdir(parents=True, exist_ok=True)
            ASKED_FLAG.touch()
            box.hide()
            if connect:
                self.connect_ai()
            else:
                self.add("No problem! You can connect one any time with the button at the top.", mine=False)

        yes.clicked.connect(lambda: answered(True))
        later.clicked.connect(lambda: answered(False))

    def connect_ai(self):
        if ai.setup_dialog(self):
            cfg = ai.load()
            self.brain.history.clear()
            self.add(f"Connected to {ai.PROVIDERS[cfg['provider']]['label']} ({cfg['model']}). "
                     "Now we can talk about anything!", mine=False)
        self.refresh_ai_button()

    def add(self, text, mine):
        bubble = Bubble(text, mine)
        row = QHBoxLayout()
        if mine:
            row.addStretch(1)
            row.addWidget(bubble)
        else:
            row.addWidget(bubble)
            row.addStretch(1)
        self.chat.addLayout(row)
        QTimer.singleShot(30, lambda: self.scroll.verticalScrollBar().setValue(
            self.scroll.verticalScrollBar().maximum()))

    def send(self, text):
        text = text.strip()
        if not text or self.puff.busy:
            return
        self.input.clear()
        self.add(text, mine=True)
        self.puff.busy = True
        self.status.setText("Thinking…")
        self.asked.emit(text)

    def on_answer(self, reply):
        self.puff.busy = False
        self.status.setText("Your SkyLine cloud. Ask me to change things!")
        self.add(reply, mine=False)

    def closeEvent(self, event):
        self.thread.quit()
        self.thread.wait(2000)
        super().closeEvent(event)


def main():
    if len(sys.argv) > 1 and sys.argv[1] in ("-h", "--help"):
        print(__doc__)
        return 0
    if len(sys.argv) > 2 and sys.argv[1] == "--ask":  # one-shot, for scripts: skyline-assistant --ask "make it night"
        print(local_brain(" ".join(sys.argv[2:])) or NO_KEY)
        return 0
    app = QApplication(sys.argv)
    app.setApplicationName("skyline-assistant")
    app.setDesktopFileName("skyline-assistant")
    w = AssistantWindow()
    w.show()
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
