#!/usr/bin/env bash
# skyline-update: keep SkyLine itself up to date. (Discover updates Debian and your Flatpak apps.)
#
#   skyline-update check     is a newer SkyLine out?  (exit 0 = up to date, 10 = update available)
#   skyline-update install   download it, check it, install it
#   skyline-update notify    check, and show a notification with an "Update now" button
#   skyline-update system    open Discover's updates page (Debian packages and apps)
#
# New versions come from the SkyLine GitHub releases (see /usr/share/skyline/update.conf).
set -euo pipefail
# shellcheck source=/dev/null
. "${SKYLINE_LIB:-/usr/lib/skyline}/i18n.sh"

# shellcheck disable=SC1091
. /usr/share/skyline/update.conf
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/skyline"

usage() {
	sed -n '2,9s/^# \{0,1\}//p' "$0"
}

installed_version() {
	dpkg-query -W -f='${Version}' skyline-desktop 2>/dev/null || echo 0
}

# Prints: VERSION DEB_URL SHA256_URL
latest_release() {
	curl -fsS --max-time 20 -H "Accept: application/vnd.github+json" \
		"https://api.github.com/repos/$REPO/releases/latest" | python3 -c '
import json, sys
r = json.load(sys.stdin)
version = r["tag_name"].lstrip("v")
deb = sha = ""
for a in r.get("assets", []):
    if a["name"].endswith("_all.deb"):
        deb = a["browser_download_url"]
    elif a["name"].endswith("_all.deb.sha256"):
        sha = a["browser_download_url"]
print(version, deb, sha)
'
}

check() {
	local info version deb
	if ! info=$(latest_release 2>/dev/null); then
		t "Couldn't reach GitHub. Check your internet connection."; echo
		return 1
	fi
	read -r version deb _ <<<"$info"
	if [[ -n $deb ]] && dpkg --compare-versions "$version" gt "$(installed_version)"; then
		tf "SkyLine %s is available (you have %s)." "$version" "$(installed_version)"; echo
		return 10
	fi
	tf "SkyLine is up to date (%s)." "$(installed_version)"; echo
	return 0
}

install_update() {
	local info version deb sha tmp
	info=$(latest_release) || {
		t "Couldn't reach GitHub. Check your internet connection."; echo
		exit 1
	}
	read -r version deb sha <<<"$info"
	if [[ -z $deb ]]; then
		t "The latest release has no SkyLine package yet. Try again later."; echo
		exit 1
	fi
	if ! dpkg --compare-versions "$version" gt "$(installed_version)"; then
		tf "SkyLine is already up to date (%s)." "$(installed_version)"; echo
		exit 0
	fi
	tmp=$(mktemp -d)
	trap 'rm -rf "$tmp"' EXIT
	tf "Downloading SkyLine %s ..." "$version"; echo
	curl -fL --progress-bar -o "$tmp/skyline-desktop_${version}_all.deb" "$deb"
	if [[ -n $sha ]]; then
		curl -fsSL -o "$tmp/expected.sha256" "$sha"
		local want got
		want=$(cut -d' ' -f1 "$tmp/expected.sha256")
		got=$(sha256sum "$tmp/skyline-desktop_${version}_all.deb" | cut -d' ' -f1)
		if [[ $want != "$got" ]]; then
			t "The download is damaged (checksum doesn't match). Nothing was installed."; echo
			exit 1
		fi
		t "Download checked."; echo
	fi
	t "Installing (SkyLine will ask for your password) ..."; echo
	pkexec apt-get install -y -o Dpkg::Options::=--force-confnew "$tmp/skyline-desktop_${version}_all.deb"
	echo
	tf "SkyLine %s installed. Log out and back in to see everything new." "$version"; echo
}

notify() {
	local msg rc=0 version
	msg=$(check) || rc=$?
	[[ $rc -eq 10 ]] || return 0
	version=$(awk '{print $2}' <<<"$msg")
	mkdir -p "$STATE_DIR"
	# Ask only once per version.
	if [[ -f $STATE_DIR/update-notified && $(cat "$STATE_DIR/update-notified") == "$version" ]]; then
		return 0
	fi
	echo "$version" >"$STATE_DIR/update-notified"
	local action
	action=$(notify-send -a SkyLine -i skyline -A update="$(t "Update now")" -A later="$(t "Later")" \
		"$(tf "SkyLine %s is ready" "$version")" "$(t "New features and fixes for your desktop.")" 2>/dev/null || true)
	if [[ $action == update ]]; then
		# The full-screen update screen (falls back to a terminal window if it can't start).
		setsid -f sh -c 'skyline-update-screen || konsole --hold -e skyline-update install' >/dev/null 2>&1
	fi
}

case "${1:-check}" in
	check) check ;;
	install) install_update ;;
	notify) notify ;;
	system) exec plasma-discover --mode update ;;
	-h | --help) usage ;;
	*)
		usage >&2
		exit 2
		;;
esac
