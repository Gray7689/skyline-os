#!/bin/sh
# Installs NVIDIA's own graphics driver, Secure Boot friendly. Run as root (SkyLine starts it with pkexec).
# Steps: non-free sources, kernel headers + DKMS, Secure Boot signing key, driver, display support.
set -eu
# shellcheck source=/dev/null
. "${SKYLINE_LIB:-/usr/lib/skyline}/i18n.sh"

MOK_PASSWORD=skyline1

if ! lspci | grep -qi nvidia; then
	t "No NVIDIA graphics card found on this computer. Nothing to do."; echo
	exit 0
fi

/usr/lib/skyline/ensure-nonfree

echo
t "Installing kernel headers and DKMS ..."; echo
DEBIAN_FRONTEND=noninteractive apt-get install -y linux-headers-amd64 dkms mokutil

need_enroll=0
if mokutil --sb-state 2>/dev/null | grep -q "SecureBoot enabled"; then
	[ -f /var/lib/dkms/mok.pub ] || dkms generate_mok
	if mokutil --test-key /var/lib/dkms/mok.pub 2>/dev/null | grep -q "already enrolled"; then
		t "Secure Boot key already registered."; echo
	else
		printf '%s\n%s\n' "$MOK_PASSWORD" "$MOK_PASSWORD" | mokutil --import /var/lib/dkms/mok.pub
		need_enroll=1
	fi
fi

echo
t "Installing the NVIDIA driver (a few minutes) ..."; echo
DEBIAN_FRONTEND=noninteractive apt-get install -y nvidia-driver firmware-misc-nonfree nvidia-smi

# Let the driver run screens too (needed for monitors plugged into the NVIDIA card).
echo "options nvidia-drm modeset=1 fbdev=1" >/etc/modprobe.d/nvidia-drm.conf
update-initramfs -u

echo
echo "================================================================"
printf " "; t "NVIDIA driver installed. Restart your computer to use it."; echo
if [ "$need_enroll" = 1 ]; then
	echo
	printf " "; t "After the restart a BLUE screen appears (MOK Manager). Quickly press a key, then:"; echo
	printf "   Enroll MOK  ->  Continue  ->  Yes  ->  "; tf "type the password: %s" "$MOK_PASSWORD"; echo "  ->  Reboot"
	printf " "; t "This happens only once. It lets Secure Boot trust the driver."; echo
fi
echo "================================================================"
