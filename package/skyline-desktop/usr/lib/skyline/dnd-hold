#!/usr/bin/env python3
"""Keep Plasma's Do Not Disturb on while this process runs. Game Mode starts and stops it.

Usage: dnd-hold PIDFILE
"""
import os
import signal
import sys

import dbus


def main():
    pidfile = sys.argv[1] if len(sys.argv) > 1 else None
    bus = dbus.SessionBus()
    obj = bus.get_object("org.freedesktop.Notifications", "/org/freedesktop/Notifications")
    notifications = dbus.Interface(obj, "org.freedesktop.Notifications")
    cookie = notifications.Inhibit("skyline-gamemode", "Game Mode", dbus.Dictionary({}, signature="sv"))

    def stop(*_):
        try:
            notifications.UnInhibit(cookie)
        finally:
            if pidfile and os.path.exists(pidfile):
                os.remove(pidfile)
            sys.exit(0)

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    if pidfile:
        with open(pidfile, "w") as f:
            f.write(str(os.getpid()))
    while True:
        signal.pause()


if __name__ == "__main__":
    main()
