// SkyLine boot splash for Plymouth.
// Peach background, centered logo, progress bar, and a password box for encrypted disks.

Window.SetBackgroundTopColor(1.0, 0.847, 0.8);
Window.SetBackgroundBottomColor(1.0, 0.847, 0.8);

screen_x = Window.GetX();
screen_y = Window.GetY();
screen_w = Window.GetWidth();
screen_h = Window.GetHeight();
center_x = screen_x + screen_w / 2;

// Logo
logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.x = center_x - logo.image.GetWidth() / 2;
logo.y = screen_y + screen_h / 2 - logo.image.GetHeight() / 2 - 40;
logo.sprite.SetPosition(logo.x, logo.y, 1);

// Progress bar
track.image = Image("bar-bg.png");
track.sprite = Sprite(track.image);
track.x = center_x - track.image.GetWidth() / 2;
track.y = logo.y + logo.image.GetHeight() + 48;
track.sprite.SetPosition(track.x, track.y, 1);

fill.image = Image("bar-fill.png");
fill.sprite = Sprite();
fill.sprite.SetPosition(track.x, track.y, 2);

fun progress_callback(duration, progress) {
    width = Math.Int(fill.image.GetWidth() * progress);
    if (width < 8) {
        width = 8;
    }
    fill.sprite.SetImage(fill.image.Scale(width, fill.image.GetHeight()));
}
Plymouth.SetBootProgressFunction(progress_callback);

// Password prompt (encrypted disk)
prompt.sprite = Sprite();
bullets.sprite = Sprite();

fun display_password_callback(prompt_text, bullet_count) {
    prompt.image = Image.Text(prompt_text, 0.137, 0.149, 0.29);
    prompt.sprite.SetImage(prompt.image);
    prompt.sprite.SetPosition(center_x - prompt.image.GetWidth() / 2, track.y + 40, 3);
    prompt.sprite.SetOpacity(1);

    dots = "";
    i = 0;
    while (i < bullet_count) {
        dots = dots + "● ";
        i = i + 1;
    }
    if (dots == "") {
        dots = " ";
    }
    bullets.image = Image.Text(dots, 0.137, 0.149, 0.29);
    bullets.sprite.SetImage(bullets.image);
    bullets.sprite.SetPosition(center_x - bullets.image.GetWidth() / 2, track.y + 72, 3);
    bullets.sprite.SetOpacity(1);
}

fun display_normal_callback() {
    prompt.sprite.SetOpacity(0);
    bullets.sprite.SetOpacity(0);
}

Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);

// Messages (for example "Checking disk...")
message.sprite = Sprite();
fun message_callback(text) {
    message.image = Image.Text(text, 0.137, 0.149, 0.29);
    message.sprite.SetImage(message.image);
    message.sprite.SetPosition(center_x - message.image.GetWidth() / 2, screen_y + screen_h - 60, 3);
}
Plymouth.SetMessageFunction(message_callback);
